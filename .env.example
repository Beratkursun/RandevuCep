# -----------------------------------------------------------------------------
# PassoKlon — Ortam Değişkenleri Şablonu
#
# Kullanım: bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
#   PowerShell  : Copy-Item .env.example .env
#   macOS/Linux : cp .env.example .env
#
# Gerçek değerler yalnızca .env içinde durur (.gitignore ile hariç tutulur).
# Depoda kalan bu şablon dosyasında gerçek token / ID bulunmamalıdır.
# -----------------------------------------------------------------------------

# --- Telegram Botu -----------------------------------------------------------
# @BotFather'dan alınan bot token'ı ("123456789:AAH..." biçiminde).
# GİZLİ: tarayıcıya sızmaması için başına asla "PUBLIC_" eklenmez; sadece
# sunucu tarafında veya Tauri (Rust) tarafında okunur.
TELEGRAM_BOT_TOKEN=

# --- Yönetici (Admin) Chat ID ------------------------------------------------
# Botun bildirim göndereceği yönetici sohbetinin sayısal kimliği.
# Kişisel sohbet için pozitif (örn. 123456789),
# grup/kanal için negatif (örn. -1001234567890) olur.
# Bulmak için bota bir mesaj atıp şu adresi açın:
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# ve "chat" -> "id" alanına bakın (alternatif: @userinfobot).
TELEGRAM_ADMIN_CHAT_ID=
